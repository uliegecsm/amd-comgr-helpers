ARG BASE_IMAGE

FROM $BASE_IMAGE

# Install system requirements.
RUN --mount=target=/requirements,type=bind,source=requirements <<EOF
    set -ex

    apt update

    apt --yes --no-install-recommends install $(grep -vE "^\s*#" /requirements/requirements.system.txt  | tr "\n" " ")

    # CMake.
    apt --yes --no-install-recommends install ca-certificates lsb-release gpg wget
    wget -O - https://apt.kitware.com/keys/kitware-archive-latest.asc 2>/dev/null | gpg --dearmor - | tee /usr/share/keyrings/kitware-archive-keyring.gpg >/dev/null
    echo "deb [signed-by=/usr/share/keyrings/kitware-archive-keyring.gpg] https://apt.kitware.com/ubuntu/ $(lsb_release -sc) main" | tee /etc/apt/sources.list.d/kitware.list >/dev/null
    apt update
    rm /usr/share/keyrings/kitware-archive-keyring.gpg
    apt --yes --no-install-recommends install kitware-archive-keyring
    apt --yes --no-install-recommends install cmake

    apt clean && rm -rf /var/lib/apt/lists/*
EOF

# Create a virtual environment for Python packages.
ENV VIRTUAL_ENV=/opt/venv
ENV PATH=${VIRTUAL_ENV}/bin:${PATH}
RUN python3 -m venv $VIRTUAL_ENV

# Install Python requirements.
RUN --mount=target=/requirements,type=bind,source=requirements <<EOF
    python3 -m pip install -r /requirements/requirements.python.txt
EOF
